class Solution {
public:
    vector<int> sortArrayByParity(vector<int>& nums) {
        int i = 0, high = nums.size()-1;
        while(i<=high){
            if(nums[i]%2==1){
                swap(nums[high], nums[i]);
                high--;
            }
            else i++;
        }
        return nums;
    }
};
