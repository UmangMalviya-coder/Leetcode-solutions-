class Solution {
public:
    bool isPalindrome(string s) {
        int i = 0;

        while (i < s.length()) {
            if ((s[i] >= 'a' && s[i] <= 'z') ||
                (s[i] >= '0' && s[i] <= '9')) {
                i++;
            }
            else if (s[i] >= 'A' && s[i] <= 'Z') {
                s[i] = s[i] + 32;
                i++;
            }
            else {
                s.erase(i, 1);
            }
        }

        string s2 = s;
        reverse(s2.begin(), s2.end());

        return s2 == s;
    }
};
